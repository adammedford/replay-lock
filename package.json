{
  "name": "replaylock",
  "version": "0.1.0",
  "private": true,
  "description": "Opt-in reviewed characterization cases for Vitest",
  "type": "module",
  "bin": {
    "replaylock": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "default": "./dist/vite-plugin.js"
    },
    "./vite/runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/value-adapters.md",
    "docs/trusted-packages.md",
    "docs/troubleshooting.md",
    "docs/pilot-checklist.md"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "npm@11.5.2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node scripts/run-verification.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node scripts/run-verification.mjs"
  },
  "dependencies": {
    "magic-string": "1.2.2",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "22.20.1"
  }
}
