{
  "name": "replaylock",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Opt-in reviewed characterization cases for Vitest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adammedford/replay-lock.git"
  },
  "homepage": "https://github.com/adammedford/replay-lock#readme",
  "bugs": {
    "url": "https://github.com/adammedford/replay-lock/issues"
  },
  "type": "module",
  "bin": {
    "replaylock": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "default": "./dist/vite-plugin.js"
    },
    "./vite/runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/value-adapters.md",
    "docs/trusted-packages.md",
    "docs/troubleshooting.md",
    "docs/pilot-checklist.md",
    "docs/ci.md",
    "examples/github-actions"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "npm@11.5.2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node scripts/verify.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:dogfood": "node scripts/verify-dogfood.mjs",
    "coverage": "node scripts/run-coverage.mjs"
  },
  "dependencies": {
    "magic-string": "1.2.2",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "devDependencies": {
    "@jridgewell/sourcemap-codec": "1.5.5",
    "@types/node": "22.20.1",
    "c8": "12.0.0"
  }
}
