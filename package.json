{
  "name": "replaylock",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Opt-in reviewed characterization cases for Vitest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adammedford/replay-lock.git"
  },
  "homepage": "https://github.com/adammedford/replay-lock#readme",
  "bugs": {
    "url": "https://github.com/adammedford/replay-lock/issues"
  },
  "type": "module",
  "bin": {
    "replaylock": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/dev-browser-api.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "default": "./dist/vite-plugin.js"
    },
    "./vite/runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./dev/runtime": {
      "types": "./dist/dev-runtime.d.ts",
      "default": "./dist/dev-runtime.js"
    },
    "./dev/values": {
      "types": "./dist/dev-values.d.ts",
      "default": "./dist/dev-values.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/value-adapters.md",
    "docs/trusted-packages.md",
    "docs/troubleshooting.md",
    "docs/pilot-checklist.md",
    "docs/ci.md",
    "docs/development-recording.md",
    "docs/performance.md",
    "docs/pilots/README.md",
    "examples/github-actions"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "npm@11.5.2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node scripts/verify.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:dogfood": "node scripts/verify-dogfood.mjs",
    "coverage": "node scripts/run-coverage.mjs",
    "bench:dev": "node scripts/bench-dev.mjs",
    "pilot:dev": "node scripts/pilot-dev.mjs",
    "conformance:dev": "node scripts/dev-conformance.mjs"
  },
  "dependencies": {
    "magic-string": "1.2.2",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "devDependencies": {
    "@jridgewell/sourcemap-codec": "1.5.5",
    "@types/node": "22.20.1",
    "c8": "12.0.0"
  },
  "optionalDependencies": {
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.63.0"
  }
}
